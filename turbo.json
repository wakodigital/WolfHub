{
  "$schema": "https://turbo.build/json-schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "outputs": ["dist/**", "build/**", ".next/**"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": [".eslintcache"],
      "cache": true
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": []
    },
    "db:seed": {
      "cache": false,
      "dependsOn": ["db:migrate"]
    },
    "db:generate": {
      "cache": false
    }
  },
  "globalDependencies": ["**/.env", "turbo.json"]
}